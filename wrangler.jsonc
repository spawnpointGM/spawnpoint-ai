{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spawnpoint-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/play/*", "/cover/*", "/game/*"]
  },
  // Created automatically on first deploy (no IDs needed).
  "d1_databases": [{ "binding": "DB", "database_name": "spawnpoint-ai-db" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "spawnpoint-ai-games" }],
  // Workers AI checks listings and images for adult content (free daily allowance; no charge on the free plan).
  "ai": { "binding": "AI" },
  "vars": {
    "SITE_NAME": "SpawnpointAI",
    "MAX_GAME_MB": "50",
    "MAX_FILES": "1000",
    "NEW_GAMES_PER_DAY": "10",
    // Stay under R2's free tier (10 GB stored, 1M writes a month). Uploads pause at these caps.
    "R2_MAX_GB": "9",
    "R2_MAX_WRITES_PER_MONTH": "900000"
  },
  "observability": { "enabled": true }
}
