{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spawnpoint-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/play/*", "/cover/*", "/game/*"]
  },
  // Created automatically on first deploy (no IDs needed).
  "d1_databases": [{ "binding": "DB", "database_name": "spawnpoint-ai-db" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "spawnpoint-ai-games" }],
  "vars": {
    "SITE_NAME": "SpawnpointAI",
    "MAX_GAME_MB": "50",
    "MAX_FILES": "1000",
    "NEW_GAMES_PER_DAY": "10"
  },
  "observability": { "enabled": true }
}
